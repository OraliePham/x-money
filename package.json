{
  "name": "playwright-ts-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Maintainable Playwright + TypeScript automation framework starter.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "install:browsers": "playwright install --with-deps",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test tests/api",
    "profile:open": "tsx src/profile-launcher.ts profile_01_id https://x.com",
    "profile:test-stealth": "tsx src/test-stealth.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "clean": "rimraf playwright-report test-results artifacts/.tmp"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "dependencies": {
    "@ndaidong/txtgen": "^4.0.1",
    "better-sqlite3": "^12.9.0"
  }
}
